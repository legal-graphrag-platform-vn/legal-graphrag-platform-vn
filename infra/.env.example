# Neo4j
NEO4J_PASSWORD=changeme_strong_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Connection string dùng cho Python driver và pipeline
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# PostgreSQL — conversation context store (Plan 19)
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=graphrag_conversations
POSTGRES_PORT=5432

# Async SQLAlchemy/asyncpg URL used by the backend.
DATABASE_URL=postgresql+asyncpg://graphrag:changeme_strong_password@localhost:5432/graphrag_conversations

# Minimum 32 bytes; required when ANSWER_GENERATION_ENABLED=true.
ANONYMOUS_PRINCIPAL_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_bytes_long

# --- Observability (Plan 21) — docker-compose.observability.yml -------------
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
# Backend (apps/backend/.env): point the trace logger at the file Promtail tails.
# CHAT_TRACE_LOG_FILE=infra/data/logs/chat-trace.log
# CHAT_TRACE_LLM_IO=redacted   # off | redacted | full
# LOG_LEVEL=INFO
