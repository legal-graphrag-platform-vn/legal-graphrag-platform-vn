# ============================================================
# infra/env/.env.example
# Copy từng file tương ứng và điền giá trị thật:
#   cp .env.example.compose  .env.compose
#   cp .env.example.backend  .env.backend
#   cp .env.example.frontend .env.frontend
# ============================================================

# === .env.compose ===
# Shared infra vars cho neo4j, postgres, backend

NEO4J_PASSWORD=changeme_strong_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

POSTGRES_USER=graphrag
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=graphrag_conversations
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://graphrag:changeme_strong_password@postgres:5432/graphrag_conversations

ANONYMOUS_PRINCIPAL_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_bytes_long

# === .env.backend ===
# Runtime config cho backend service

APP_MODE=live
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CORS_ORIGINS=["*"]
BACKEND_PORT=8000

# === .env.frontend ===
# Runtime config cho frontend service

NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
