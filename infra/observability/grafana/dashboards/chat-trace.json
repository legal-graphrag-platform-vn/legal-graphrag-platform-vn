{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Chat Trace (Plan 21)",
  "uid": "chat-trace",
  "tags": ["legal-graphrag", "chat", "trace"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "label": "trace_id",
        "type": "textbox",
        "current": { "text": ".*", "value": ".*" },
        "query": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Turn timeline (filter by trace_id)",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"chat-trace\"} | json | trace_id=~\"$trace_id\""
        }
      ]
    },
    {
      "id": 3,
      "title": "RAG pipeline (query → retrieval → generation)",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"chat-trace\", stage=~\"query_processor[.].*|retrieval[.].*|generation[.].*\"} | json | trace_id=~\"$trace_id\""
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors & cannot_answer (all turns)",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"chat-trace\"} |~ \"(?i)(failed|error|cannot_answer)\""
        }
      ]
    }
  ]
}
