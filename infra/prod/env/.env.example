# ============================================================
# infra/prod/env/.env.example
# Tạo 3 file từ template này:
#   cp .env.example .env.compose   && vi .env.compose
#   cp .env.example .env.backend   && vi .env.backend
#   cp .env.example .env.frontend  && vi .env.frontend
# ============================================================

# === .env.compose ===
# Shared credentials — neo4j password, postgres, signing key

NEO4J_PASSWORD=changeme_strong_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

POSTGRES_USER=graphrag
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=graphrag_conversations
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://graphrag:changeme_strong_password@postgres:5432/graphrag_conversations

ANONYMOUS_PRINCIPAL_SIGNING_KEY=change_me_run_openssl_rand_base64_48

# === .env.backend ===
# Runtime config cho backend

APP_MODE=live
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CORS_ORIGINS=["https://legalrag.lamdx4.servebeer.com"]
BACKEND_PORT=8000

# === .env.frontend ===
# Runtime config cho frontend (Next.js đọc PORT natively)

NEXT_PUBLIC_API_URL=https://legalrag-api.lamdx4.servebeer.com
PORT=3001
