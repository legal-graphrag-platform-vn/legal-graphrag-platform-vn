# ============================================================
# infra/prod/env/.env.example
# ============================================================

# === .env.compose ===
# Infrastructure credentials (Neo4j & Postgres)
NEO4J_PASSWORD=changeme_strong_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

POSTGRES_USER=graphrag
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=graphrag_conversations
POSTGRES_PORT=5432

# === .env.backend ===
# Backend runtime configuration
APP_MODE=graphrag
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_strong_password

DATABASE_URL=postgresql+asyncpg://graphrag:changeme_strong_password@postgres:5432/graphrag_conversations
ANONYMOUS_PRINCIPAL_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_bytes_long

LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

CORS_ORIGINS=["https://legalrag.lamdx4.servebeer.com"]
BACKEND_PORT=8000

# === .env.frontend ===
# Frontend runtime configuration (Next.js)
NEXT_PUBLIC_API_URL=https://legalrag-api.lamdx4.servebeer.com
PORT=3001
