# ============================================================
# infra/prod/env/.env.example
# ============================================================

# === .env.compose === (Dành riêng cho Neo4j, Postgres & Grafana)
NEO4J_AUTH=neo4j/changeme_strong_password
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=graphrag_conversations
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# === .env.backend === (Dành riêng cho Backend)
APP_MODE=graphrag
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_strong_password

DATABASE_URL=postgresql+asyncpg://graphrag:changeme_strong_password@postgres:5432/graphrag_conversations
ANONYMOUS_PRINCIPAL_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_bytes_long

ANSWER_GENERATION_ENABLED=true
ANSWER_PROVIDER=gemini
ANSWER_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

CORS_ORIGINS=["https://legalrag.lamdx4.servebeer.com", "https://legalrag.lamdx4.duckdns.org"]

# Observability & Trace Logging (Plan 21)
LOG_LEVEL=INFO
CHAT_TRACE_LOG_FILE=/var/log/chat/chat-trace.log
CHAT_TRACE_LLM_IO=redacted
CHAT_TRACE_PERSIST=failed

# === .env.frontend === (Dành riêng cho Frontend)
NEXT_PUBLIC_API_URL=https://legalrag-api.lamdx4.duckdns.org
INTERNAL_API_URL=http://backend:8000
PORT=3001
