{
   "version": "0.0.1",
   "configurations": [
      {
         "name": "backend",
         "runtimeExecutable": "uv",
         "runtimeArgs": ["run", "uvicorn", "main:app", "--port", "8000"],
         "env": { "PYTHONPATH": "apps/backend;.", "PYTHONIOENCODING": "utf-8" },
         "port": 8000
      },
      {
         "name": "frontend",
         "runtimeExecutable": "npm",
         "runtimeArgs": ["--prefix", "apps/frontend", "run", "dev"],
         "port": 3000
      }
   ]
}
